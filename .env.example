# ─────────────────────────────────────────────────────────────
# Facha Style · variables de entorno (EJEMPLO, sin secretos reales)
# Copia a .env para desarrollo. En Vercel configúralas en Project → Settings → Environment Variables,
# con valores DISTINTOS para Preview y Production.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
# URL pública de la web (se usa en enlaces de gestión, QR y URLs de retorno de pago)
APP_URL=http://localhost:3000
# Opcional: si es una sola barbería, la raíz "/" redirige a /b/<slug>
DEFAULT_PUBLIC_SLUG=

# ── Base de datos ────────────────────────────────────────────
# Local (Docker): postgresql://facha:facha_dev_password@127.0.0.1:5433/facha_local
# Supabase runtime (pooler transaccional, puerto 6543):
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://facha:facha_dev_password@127.0.0.1:5433/facha_local
# Supabase migraciones (conexión directa o session pooler, puerto 5432). Opcional en local.
DIRECT_URL=
# Base de datos de tests de integración (se BORRA en cada ejecución)
TEST_DATABASE_URL=postgresql://facha:facha_dev_password@127.0.0.1:5433/facha_test

# ── Seguridad ────────────────────────────────────────────────
# Mínimo 32 caracteres aleatorios. Genera con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# 32 bytes en base64 para cifrar credenciales de integraciones por barbería (AES-256-GCM)
# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Secreto que Vercel Cron envía como "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# ── WhatsApp Business Platform (Cloud API oficial de Meta) ───
WHATSAPP_API_VERSION=v23.0
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Opcional: credenciales globales de respaldo. Lo normal es configurarlas por barbería en /admin/configuracion.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── Mercado Pago ─────────────────────────────────────────────
# Opcional como respaldo global; lo normal es por barbería (cada barbería cobra en su cuenta).
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# ── Correo transaccional ─────────────────────────────────────
# console = solo registra en logs (desarrollo). resend = envío real.
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM="Facha Style <reservas@example.com>"

# ── Solo desarrollo ──────────────────────────────────────────
# Habilita el proveedor de pagos FAKE (nunca disponible con NODE_ENV=production)
PAYMENTS_FAKE_ENABLED=true
